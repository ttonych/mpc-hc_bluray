+STDMETHODIMP CLAVSplitter::InitDemuxer()
+{
+    ResetPlaylistPositions();
+    for (const auto &output : SelectOutputStreams(m_pDemuxer))
+    {
+        const auto *name = output.type == CBaseDemuxer::video_el ? L"~EL" : CBaseDemuxer::CStreamList::ToStringW(output.type);
+        HRESULT hr = S_OK;
+        auto *pin = new CLAVOutputPin(output.stream->streamInfo->mtypes, name, this, this, &hr, output.type,
+                                      m_pDemuxer->GetContainerFormat());
+        if (FAILED(hr))
+        {
+            delete pin;
+            return hr;
+        }
+        pin->SetStreamId(output.stream->pid);
+        m_pPins.push_back(pin);
+        m_pDemuxer->SetActiveStream(output.type, output.stream->pid);
+    }
+    return m_pPins.empty() ? E_FAIL : S_OK;
+}
+
+STDMETHODIMP CLAVSplitter::SwitchPlaylist(LPCWSTR playlist)
+{
+    CheckPointer(playlist, E_POINTER);
+    CAutoLock lock(this);
+    if (m_State != State_Stopped)
+        return VFW_E_NOT_STOPPED;
+    if (!m_pDemuxer || _wcsicmp(PathFindExtensionW(m_fileName.c_str()), L".mpls") ||
+        _wcsicmp(PathFindExtensionW(playlist), L".mpls"))
+        return E_INVALIDARG;
+
+    std::unique_ptr<CBDDemuxer> next(new CBDDemuxer(this, this));
+    HRESULT hr = next->Open(playlist, nullptr, nullptr);
+    if (FAILED(hr))
         return hr;
-    }
+    const auto streams = SelectOutputStreams(next.get());
+    if (streams.size() != m_pPins.size())
+        return VFW_E_CANNOT_CONNECT;
+
+    // Stage the selected media types. A rejection on the last pin must leave
+    // every connected pin and the current demuxer on the original playlist.
+    std::vector<CMediaType> accepted;
+    accepted.reserve(streams.size());
+    for (size_t i = 0; i < streams.size(); ++i)
+    {
+        const auto &output = streams[i];
+        auto *pin = m_pPins[i];
+        if (pin->GetPinType() != output.type || !pin->IsConnected() || output.type == CBaseDemuxer::video_el)
+            return VFW_E_CANNOT_CONNECT;
+        auto &types = output.stream->streamInfo->mtypes;
+        auto it = std::find_if(types.begin(), types.end(), [pin](const CMediaType &type) {
+            return pin->GetConnected()->QueryAccept(&type) == S_OK;
+        });
+        if (it == types.end())
+            return VFW_E_TYPE_NOT_ACCEPTED;
+        accepted.push_back(*it);
+        next->SetActiveStream(output.type, output.stream->pid);
+    }
+
+    for (size_t i = 0; i < streams.size(); ++i)
+    {
+        auto *pin = m_pPins[i];
+        pin->SetStreamId(streams[i].stream->pid);
+        pin->SetNewMediaTypes(streams[i].stream->streamInfo->mtypes);
+        pin->SendMediaType(pin->GetActiveMediaType() == accepted[i] ? nullptr : new CMediaType(accepted[i]));
+    }
+    SafeRelease(&m_pDemuxer);
+    m_pDemuxer = next.release();
+    m_pDemuxer->AddRef();
+    m_fileName = playlist;
+    ResetPlaylistPositions();
+    m_rtLastStart = m_rtLastStop = _I64_MIN;
+    m_LastSeekers.clear();
+    m_bStopValid = FALSE;
+    return S_OK;
 }

