@@ -747,6 +747,16 @@
     }

     av_opt_set_int(m_avFormat, "correct_ts_overflow", !m_pBluRay, 0);
+
+    if (m_pBluRay && m_pBluRay->HasPlaylistDuration())
+    {
+        // libbluray supplies the playlist duration. A seek to its end can require
+        // a long forward read from the preceding access point.
+        m_avFormat->skip_estimate_duration_from_pts = 1;
+        // FORMAT_SubtitleInfo does not need PGS canvas dimensions. The subtitle
+        // decoder reads them from presentation segments during playback.
+        av_opt_set_int(m_avFormat, "probe_pgs_size", 0, 0);
+    }

     m_timeOpening = time(nullptr);
     int ret = avformat_find_stream_info(m_avFormat, nullptr);
