+// The decoder holds the receive lock here. EndFlush needs that same lock,
+// so a seek must be able to cancel an outstanding surface request.
+HRESULT CD3D11SurfaceAllocator::GetDecoderBuffer(IMediaSample **sample, HANDLE flush)
+{
+    HANDLE events[] = {flush, m_hSem};
+    for (;;)
+    {
+        HRESULT hr = GetBuffer(sample, nullptr, nullptr, AM_GBF_NOWAIT);
+        if (hr != VFW_E_TIMEOUT)
+            return hr;
+
+        DWORD wait = WaitForMultipleObjects(2, events, FALSE, INFINITE);
+        if (wait == WAIT_OBJECT_0 + 1)
+            continue;
+
+        hr = wait == WAIT_FAILED ? HRESULT_FROM_WIN32(GetLastError()) : VFW_E_WRONG_STATE;
+        // GetBuffer registered one waiter. ReleaseBuffer may already have
+        // transferred that reservation from m_lWaiting to the semaphore.
+        CAutoLock lock(this);
+        if (m_lWaiting)
+            --m_lWaiting;
+        else
+            WaitForSingleObject(m_hSem, 0);
+        return hr;
+    }
+}
