+STDMETHODIMP CLAVSplitter::FindStream(WORD pid, DWORD *index, DWORD *group, DWORD *ordinal)
+{
+    CheckPointer(index, E_POINTER);
+    CheckPointer(group, E_POINTER);
+    CheckPointer(ordinal, E_POINTER);
+    CAutoLock lock(this);
+    CheckPointer(m_pDemuxer, E_UNEXPECTED);
+    DWORD offset = 0;
+    for (int type = 0; type < CBaseDemuxer::unknown; ++type)
+    {
+        if (type == CBaseDemuxer::video_el && !m_settings.DemuxEnhancementLayer)
+            continue;
+        const auto *streams = m_pDemuxer->GetStreams((CBaseDemuxer::StreamType)type);
+        for (DWORD i = 0; i < streams->size(); ++i)
+        {
+            if (m_pDemuxer->GetTransportPID(streams->at(i).pid) == pid)
+            {
+                *index = offset + i;
+                *group = type;
+                *ordinal = i;
+                return S_OK;
+            }
+        }
+        offset += (DWORD)streams->size();
+    }
+    return VFW_E_NOT_FOUND;
+}
+
+STDMETHODIMP CLAVSplitter::SetPlayItemStop(UINT endExclusive)
+{
+    CAutoLock lock(this);
+    return m_pDemuxer ? m_pDemuxer->SetPlayItemStop(endExclusive) : E_UNEXPECTED;
+}
+
+STDMETHODIMP CLAVSplitter::GetPresentationStart(REFERENCE_TIME *start)
+{
+    CheckPointer(start, E_POINTER);
+    CAutoLock lock(this);
+    return m_pDemuxer ? m_pDemuxer->GetPresentationStart(start) : E_UNEXPECTED;
+}
