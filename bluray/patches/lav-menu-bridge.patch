+// MPEG-2 still additions: (C) 2006-2026 MPC-BE authors, GPL-3.0-or-later.
+// See the host project's bluray/ports/MPC-BE-Authors.txt and COPYING.txt.
+// Adapted from MPC-BE's isolated MPEG-2 still handling. Keep the compressed
+// I-picture, so software and avcodec-based hardware paths use their normal output.
+void CDecAvcodec::ClearMpeg2Still()
+{
+    m_mpeg2StillPacket.clear();
+    m_rtMpeg2Still = AV_NOPTS_VALUE;
+}
+
+HRESULT CDecAvcodec::DecodeMpeg2Still(const BYTE *buffer, int size, REFERENCE_TIME time, REFERENCE_TIME stop)
+{
+    AVPacket *packet = av_packet_alloc();
+    if (!packet)
+        return E_OUTOFMEMORY;
+    HRESULT hr = FillAVPacketData(packet, buffer, size, nullptr, false);
+    if (SUCCEEDED(hr))
+    {
+        packet->pts = time;
+        hr = DecodePacket(packet, time, stop);
+    }
+    av_packet_free(&packet);
+    return hr;
+}
+
+HRESULT CDecAvcodec::RepeatMpeg2Still(REFERENCE_TIME next)
+{
+    if (m_mpeg2StillPacket.empty() || m_rtMpeg2Still < 0 || next <= m_rtMpeg2Still)
+        return S_OK;
+    const REFERENCE_TIME step = GetFrameDuration();
+    if (step <= 0)
+        return S_OK;
+    const REFERENCE_TIME gap = next - m_rtMpeg2Still;
+    // Bound malformed timestamps and cadence before entering the loop.
+    if (gap / 2 < step || gap > 60 * UNITS || gap / step > 3600)
+        return S_OK;
+    const BYTE sequenceEnd[] = {0, 0, 1, 0xb7};
+    for (REFERENCE_TIME offset = step; offset < gap - step / 2; offset += step)
+    {
+        if (m_pCallback->IsInputFlushing())
+            return S_FALSE;
+        const REFERENCE_TIME time = m_rtMpeg2Still + offset;
+        HRESULT hr = DecodeMpeg2Still(m_mpeg2StillPacket.data(), int(m_mpeg2StillPacket.size()), time, time + min(step, next - time));
+        if (FAILED(hr))
+            return hr;
+        // Release the delayed reference picture without draining the decoder.
+        hr = DecodeMpeg2Still(sequenceEnd, sizeof(sequenceEnd), AV_NOPTS_VALUE, AV_NOPTS_VALUE);
+        if (FAILED(hr))
+            return hr;
+    }
+    return S_OK;
+}
