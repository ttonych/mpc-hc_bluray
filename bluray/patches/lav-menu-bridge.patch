+STDMETHODIMP CLAVSplitter::InitDemuxer()
+{
+    ResetPlaylistPositions();
+    for (const auto &output : SelectOutputStreams(m_pDemuxer))
+    {
+        const auto *name = output.type == CBaseDemuxer::video_el ? L"~EL" : CBaseDemuxer::CStreamList::ToStringW(output.type);
+        HRESULT hr = S_OK;
+        auto *pin = new CLAVOutputPin(output.stream->streamInfo->mtypes, name, this, this, &hr, output.type,
+                                      m_pDemuxer->GetContainerFormat());
+        if (FAILED(hr))
+        {
+            delete pin;
+            return hr;
+        }
+        pin->SetStreamId(output.stream->pid);
+        m_pPins.push_back(pin);
+        m_pDemuxer->SetActiveStream(output.type, output.stream->pid);
+    }
+    return m_pPins.empty() ? E_FAIL : S_OK;
+}
