+// The probe consumes no pictures. Use the active PPS/SPS only for a
+// single-slice base-layer IDR after its parameter sets and prefix SEI.
+static int can_probe_idr_headers(const HEVCContext *s, unsigned nal_idx)
+{
+    const HEVCSPS *sps = s->ps.pps_list[s->sh.pps_id]->sps;
+    if (s->vps || s->avctx->active_thread_type || s->avctx->hw_device_ctx ||
+        s->dovi_ctx.cfg.dv_profile || sps->vui.field_seq_flag ||
+        (sps->ptl.general_ptl.profile_idc != AV_PROFILE_HEVC_MAIN &&
+         sps->ptl.general_ptl.profile_idc != AV_PROFILE_HEVC_MAIN_10))
+        return 0;
+    if (!IS_IDR(s) || s->sh.slice_type != HEVC_SLICE_I ||
+        !s->sh.first_slice_in_pic_flag || s->nuh_layer_id || sps->vps->nb_layers != 1 ||
+        nal_idx + 1 != s->pkt.nb_nals || s->avctx->hwaccel || s->rpu_buf)
+        return 0;
+
+    for (unsigned i = 0; i < nal_idx; i++) {
+        const H2645NAL *nal = &s->pkt.nals[i];
+        if (nal->nuh_layer_id ||
+            (nal->type != HEVC_NAL_AUD && nal->type != HEVC_NAL_VPS &&
+             nal->type != HEVC_NAL_SPS && nal->type != HEVC_NAL_PPS &&
+             nal->type != HEVC_NAL_SEI_PREFIX))
+            return 0;
+    }
+    return 1;
+}
