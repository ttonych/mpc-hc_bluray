+static int FindPlaylistStreamInfo(AVFormatContext *format)
+{
+    std::vector<AVDictionary *> options(format->nb_streams, nullptr);
+    for (unsigned i = 0; i < options.size(); ++i)
+    {
+        if (format->streams[i]->codecpar->codec_id == AV_CODEC_ID_HEVC)
+            av_dict_set_int(&options[i], "probe_idr_headers", 1, 0);
+    }
+    int ret = avformat_find_stream_info(format, options.data());
+    for (auto &entry : options)
+        av_dict_free(&entry);
+    return ret;
+}
