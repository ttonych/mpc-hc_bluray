+STDMETHODIMP CBDDemuxer::GetNextPacket(Packet **ppPacket)
+{
+    CheckPointer(ppPacket, E_POINTER);
+    *ppPacket = nullptr;
+    if (FAILED(GetReadError()))
+        return GetReadError();
+    HRESULT hr = m_lavfDemuxer->GetNextPacket(ppPacket);
+    // Also drain events when FFmpeg produced no packet after an I/O failure.
+    ProcessBDEvents();
+    if (FAILED(GetReadError()))
+    {
+        SAFE_DELETE(*ppPacket);
+        return GetReadError();
+    }
+    return hr;
+}
